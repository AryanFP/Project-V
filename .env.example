# Server port - The port on which the application will run (default: 3000)
PORT=3000

# App package name - Your application's unique identifier.  Make sure it exactly matches the package name in the MentraOS Developer Console
PACKAGE_NAME=org.yourname.appname

# API key - Your MentraOS developer API key from the MentraOS Developer Console
MENTRAOS_API_KEY=your_api_key_here



# Google AI (Gemini) API key — for the AI assistant. Get one at aistudio.google.com
GEMINI_API_KEY=

# Public URL of THIS server, used so the glasses can fetch action sounds
# (start-vision.mp3, end-vision.mp3) directly. The glasses can't reach
# localhost — use your Porter URL in prod, or an ngrok tunnel in dev.
# Example: https://clairity-13688-abcdef.onporter.run
# Leave blank to disable action sounds.
PUBLIC_URL=
